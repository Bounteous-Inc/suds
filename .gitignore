# Composer. The lock file IS committed: it has no effect on projects that
# depend on SUDS (Composer only reads the root package's lock), but it makes
# local and CI runs reproducible and turns every dependency bump into a
# reviewable commit. Dependabot keeps it current.
/vendor/

# PHPUnit cache.
/.phpunit.cache/
/.phpunit.result.cache

# Local PHPStan overrides — never commit.
/phpstan.neon.local

# System Under Test — generated Drupal installation for functional tests.
# Provision with: composer sut:si
/sut/

# Build artefacts.
/build/

# IDE files.
/.idea/
/.vscode/
*.swp
*.swo

# macOS.
.DS_Store

# SUDS local overrides (developer-specific, never commit).
suds.local.yml

# Claude Code local session state.
/.claude/
